{% capture html_language_tag %}{% render 'html-language-tag' %}{% endcapture %}
<!doctype html>
<html lang="{{ html_language_tag }}">
  <head>
    {% # Fonts and merchant tokens %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Load the generated Tailwind CSS %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    {% # Social, title, icons, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-page focus:px-4 focus:py-3 focus:text-link"
      href="#MainContent"
    >
      {{- 'accessibility.skip_to_content' | t -}}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
