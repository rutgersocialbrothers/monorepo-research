# Prefer pnpm github:env-pull: it fills the store and optional storefront password from the develop.environment mapping in deployments/shopify.json.
# For a manual override, copy this file to .env.local here. Restart dev after changes.
# pnpm dev/dev:liquid runs native Shopify theme dev against this store.
# Shopify CLI manages the development theme and validates the configured store.
SHOPIFY_FLAG_STORE=

# Optional storefront password for password-protected stores, distinct from Theme Access.
# GitHub Environment variable SHOPIFY_THEME_PASSWORD is optional: absence preserves the
# local setting; a present empty value clears it. This is a variable, not a GitHub secret.
SHOPIFY_FLAG_STORE_PASSWORD=

# Optional local Theme Access token; GitHub secrets cannot be pulled.
# Otherwise use Shopify CLI login: select the Liquid task in Turbo and press i.
SHOPIFY_CLI_THEME_TOKEN=
