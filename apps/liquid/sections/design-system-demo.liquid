{% liquid
  assign variants = 'primary,secondary' | split: ','
  assign sizes = 'small,medium,large' | split: ','
  assign surfaces = 'page,band,brand,warm,natural' | split: ','
  assign inverse_label = 'liquid_components.design_system.inverse_button' | t
%}

<div class="design-system-demo">
  <header class="design-system-demo__intro">
    <h1>{{ 'liquid_components.design_system.title' | t | escape }}</h1>
    <p>{{ 'liquid_components.design_system.description' | t | escape }}</p>
  </header>

  <div class="design-system-demo__topic">
    <h2>{{ 'liquid_components.design_system.buttons_title' | t | escape }}</h2>
    <p>{{ 'liquid_components.design_system.buttons_description' | t | escape }}</p>
    <div class="design-system-demo__grid">
      {% for variant in variants %}
        {% liquid
          assign variant_key = 'liquid_components.design_system.variants.' | append: variant
          assign variant_label = variant_key | t
        %}
        {% for size in sizes %}
          {% liquid
            assign size_key = 'liquid_components.design_system.sizes.' | append: size
            assign size_label = size_key | t
            assign enabled_label = 'liquid_components.design_system.enabled_label' | t: variant: variant_label, size: size_label
            assign disabled_label = 'liquid_components.design_system.disabled_label' | t: variant: variant_label, size: size_label
          %}
          <div class="design-system-demo__card rounded-md border border-border">
            <h3>{{ 'liquid_components.design_system.combination' | t: variant: variant_label, size: size_label | escape }}</h3>
            <div class="design-system-demo__buttons">
              {% render 'button', label: enabled_label, variant: variant, size: size, button_type: 'button' %}
              {% render 'button', label: disabled_label, variant: variant, size: size, button_type: 'button', disabled: true %}
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <div class="design-system-demo__topic">
    <h2>{{ 'liquid_components.design_system.foundations_title' | t | escape }}</h2>
    <p>{{ 'liquid_components.design_system.foundations_description' | t | escape }}</p>
    <div class="design-system-demo__grid">
      {% for surface in surfaces %}
        {% liquid
          case surface
            when 'band'
              assign surface_classes = 'bg-surface-band'
            when 'brand'
              assign surface_classes = 'bg-surface-brand'
            when 'warm'
              assign surface_classes = 'bg-surface-warm'
            when 'natural'
              assign surface_classes = 'bg-surface-natural'
            else
              assign surface_classes = 'bg-page'
          endcase
          assign surface_title_key = 'liquid_components.design_system.surfaces.' | append: surface
        %}
        <div class="design-system-demo__card rounded-md border border-border text-text {{ surface_classes }}">
          <h3>{{ surface_title_key | t | escape }}</h3>
          <p class="text-small text-text-muted">{{ 'liquid_components.design_system.muted_sample' | t | escape }}</p>
        </div>
      {% endfor %}
      <div class="design-system-demo__card tp-on-inverse rounded-md">
        <h3>{{ 'liquid_components.design_system.surfaces.inverse' | t | escape }}</h3>
        <p class="text-small text-text-muted">{{ 'liquid_components.design_system.inverse_description' | t | escape }}</p>
        <div class="design-system-demo__buttons">
          {% render 'button', label: inverse_label, variant: 'primary', size: 'small', button_type: 'button' %}
          {% render 'button', label: inverse_label, variant: 'secondary', size: 'small', button_type: 'button' %}
        </div>
      </div>
    </div>
    <div class="design-system-demo__card rounded-md border border-border">
      <h3>{{ 'liquid_components.design_system.typography_title' | t | escape }}</h3>
      <p class="design-system-demo__type-sample text-display">{{ 'liquid_components.design_system.typography_display' | t | escape }}</p>
      <p class="design-system-demo__type-sample text-h1">{{ 'liquid_components.design_system.typography_h1' | t | escape }}</p>
      <p class="design-system-demo__type-sample text-h2">{{ 'liquid_components.design_system.typography_h2' | t | escape }}</p>
      <p class="design-system-demo__type-sample text-h3">{{ 'liquid_components.design_system.typography_h3' | t | escape }}</p>
      <p>{{ 'liquid_components.design_system.typography_description' | t | escape }}</p>
      <p class="text-small">{{ 'liquid_components.design_system.typography_small' | t | escape }}</p>
      <p class="text-caption tracking-caption">{{ 'liquid_components.design_system.typography_caption' | t | escape }}</p>
    </div>
    <div class="design-system-demo__card rounded-md border border-border">
      <h3>{{ 'liquid_components.design_system.layout_title' | t | escape }}</h3>
      <p>{{ 'liquid_components.design_system.layout_description' | t | escape }}</p>
    </div>
  </div>

  <div class="design-system-demo__topic">
    <h2>{{ 'liquid_components.design_system.image_title' | t | escape }}</h2>
    <p>{{ 'liquid_components.design_system.image_description' | t | escape }}</p>
    {% if section.settings.example_image != blank %}
      <div class="design-system-demo__image">
        {% render 'image', image: section.settings.example_image, width: 1200, sizes: '(min-width: 800px) 768px, 100vw' %}
      </div>
    {% else %}
      <p class="design-system-demo__card rounded-md border border-border">{{ 'liquid_components.design_system.image_empty' | t | escape }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .design-system-demo {
    display: grid;
    gap: 3rem;
    padding-block: var(--tp-section-spacing);
    min-width: 0;
  }

  .design-system-demo__intro,
  .design-system-demo__topic {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .design-system-demo__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .design-system-demo__card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.25rem;
    min-width: 0;
  }

  .design-system-demo__type-sample {
    font-family: var(--tp-font-heading);
    font-weight: var(--tp-font-heading-weight);
    font-style: var(--tp-font-heading-style);
  }

  .design-system-demo__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem;
  }

  .design-system-demo__buttons > button {
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  .design-system-demo__image {
    max-width: 48rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:liquid_components.general.design_system_demo",
  "settings": [
    {
      "type": "image_picker",
      "id": "example_image",
      "label": "t:liquid_components.labels.demo_image",
      "info": "t:liquid_components.info.demo_image"
    }
  ],
  "presets": [
    {
      "name": "t:liquid_components.general.design_system_demo"
    }
  ]
}
{% endschema %}
