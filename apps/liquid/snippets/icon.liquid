{%- doc -%}
  Renders a canonical inline Lucide icon without loading an external asset.
  Unknown names render nothing. A blank name uses the canonical check default.

  @param {string} [name] - Canonical icon name; defaults to check
  @param {number} [size] - 12, 16, 20, 24, 32, 48, or 64; defaults to 24
  @param {boolean} [spin] - Whether to rotate the icon; motion is disabled for reduced-motion users
  @param {string} [label] - Accessible name; omit for a decorative icon
  @param {string} [class] - Optional caller-supplied classes

  @example
  {% render 'icon', name: 'arrow-right', size: 16 %}
  {% render 'icon', name: 'info', label: info_label %}
{%- enddoc -%}

{%- liquid
  assign resolved_name = name | default: 'check'
  assign icon_size = 24
  case size
    when 12, '12'
      assign icon_size = 12
    when 16, '16'
      assign icon_size = 16
    when 20, '20'
      assign icon_size = 20
    when 32, '32'
      assign icon_size = 32
    when 48, '48'
      assign icon_size = 48
    when 64, '64'
      assign icon_size = 64
  endcase

  assign icon_is_valid = false
  case resolved_name
    when 'check', 'chevron-down', 'chevron-up', 'loader', 'arrow-right', 'home', 'search', 'menu', 'settings', 'user', 'users', 'users-round', 'bell', 'mail', 'message-square', 'phone', 'calendar', 'clock', 'compass', 'heart-handshake', 'heart', 'star', 'bookmark', 'share-2', 'link', 'send', 'download', 'upload', 'copy', 'pencil', 'trash-2', 'plus', 'minus', 'x', 'ellipsis', 'filter', 'eye', 'lock', 'log-out', 'globe', 'map-pin', 'image', 'file', 'folder', 'cloud', 'shopping-cart', 'credit-card', 'zap', 'sparkles', 'info', 'triangle-alert', 'printer', 'sun', 'moon', 'chevron-left', 'chevron-right', 'columns-3', 'columns-4', 'list', 'ruler', 'arrow-up-right'
      assign icon_is_valid = true
  endcase
-%}

{%- if icon_is_valid -%}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="tp-icon{% if spin == true %} tp-icon--spin{% endif %}{% if class != blank %} {{ class | escape }}{% endif %}"
    focusable="false"
    {% if label != blank %}
      role="img"
      aria-label="{{ label | escape }}"
    {% else %}
      aria-hidden="true"
    {% endif %}
  >
  {%- case resolved_name -%}
    {%- when 'check' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"/>
    {%- when 'chevron-down' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/>
    {%- when 'chevron-up' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 15l-6-6l-6 6"/>
    {%- when 'loader' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 1 1-6.219-8.56"/>
    {%- when 'arrow-right' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7-7l7 7l-7 7"/>
    {%- when 'home' -%}
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></g>
    {%- when 'search' -%}
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></g>
    {%- when 'menu' -%}
      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16M4 12h16M4 19h16"/>
    {%- when 'settings' -%}
