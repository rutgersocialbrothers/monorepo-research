{% doc %}
  Renders an introduction and a list of selling points with a check mark, one point per line of the text field.
  Both fields can be connected to product metafields in the theme editor. Renders nothing when both are empty.

  @example
  {% content_for 'block', type: 'product-highlights', id: 'highlights' %}
{% enddoc %}

{% liquid
  assign highlight_lines = block.settings.items | newline_to_br | split: '<br />'
%}

{% if block.settings.intro != blank or block.settings.items != blank %}
  <div class="grid gap-5" {{ block.shopify_attributes }}>
    {% if block.settings.intro != blank %}
      <p class="text-h3 font-regular text-text">{{ block.settings.intro | escape }}</p>
    {% endif %}
    {% if block.settings.items != blank %}
      <ul class="m-0 grid list-none gap-3 p-0">
        {% for line in highlight_lines %}
          {% assign highlight = line | strip %}
          {% if highlight != blank %}
            <li class="flex items-start gap-3">
              <span class="mt-0.5 shrink-0 text-success">{% render 'icon', name: 'check', size: 16 %}</span>
              {{ highlight | escape }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:liquid_components.general.product_highlights",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "t:liquid_components.labels.intro"
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "t:liquid_components.labels.highlights",
      "info": "t:liquid_components.info.highlights"
    }
  ],
  "presets": [{ "name": "t:liquid_components.general.product_highlights" }]
}
{% endschema %}
