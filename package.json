{
  "name": "@tupak/shopify-theme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "build": "turbo run build demo:build",
    "check": "turbo run //#check:scripts //#check:tests @2digits/liquid#check @tupak/design-system#check:01-format @tupak/design-system#check:02-types @tupak/design-system#check:03-lint @tupak/design-system#check:04-demo-build @tupak/design-system#check:05-browser --continue=always --concurrency=1 --env-mode=loose",
    "check:scripts": "pnpm run typecheck:scripts",
    "check:tests": "pnpm run test",
    "check:design-system": "pnpm --filter @tupak/design-system check",
    "test:design-system": "pnpm --filter @tupak/design-system test",
    "preview:design-system": "pnpm --filter @tupak/design-system preview",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:liquid": "turbo run build --filter=@2digits/liquid",
    "build:design-system": "turbo run demo:build --filter=@tupak/design-system",
    "dev": "turbo watch @2digits/liquid#dev @tupak/design-system#dev:server --ui=tui --continue=always",
    "dev:design-system": "pnpm --filter @tupak/design-system dev:server",
    "dev:liquid": "turbo watch dev --filter=@2digits/liquid --ui=tui",
    "dev:liquid:local": "turbo watch build --filter=@2digits/liquid --ui=tui",
    "github:env-pull": "node scripts/github-env-pull.ts"
  },
  "devDependencies": {
    "@2digits/oxfmt-config": "catalog:",
    "@2digits/oxlint-config": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "2.11.5",
    "typescript-native": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
