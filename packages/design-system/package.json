{
  "name": "@tupak/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./themes": "./src/tokens/themes.ts",
    "./contracts": "./src/contracts/schema.ts",
    "./*-contract": "./src/components/*/*.contract.ts"
  },
  "scripts": {
    "check": "turbo run check:01-format check:02-types check:03-lint check:04-demo-build check:05-browser --filter=@tupak/design-system --continue=always --concurrency=1 --env-mode=loose",
    "check:01-format": "pnpm format",
    "check:02-types": "pnpm types",
    "check:03-lint": "pnpm lint",
    "check:04-demo-build": "pnpm demo:build",
    "check:05-browser": "pnpm test",
    "demo:build": "astro build",
    "design:detect": "impeccable detect src",
    "dev": "turbo run dev:server --filter=@tupak/design-system --continue=always",
    "dev:server": "astro dev --host 0.0.0.0 --ignore-lock",
    "format": "oxfmt --config ../../oxfmt.config.ts --ignore-path ../../.gitignore --check .",
    "lint": "pnpm run --sequential --no-bail \"/^lint:(source|classes)$/\"",
    "lint:classes": "eslint --max-warnings 0 src",
    "lint:classes:fix": "pnpm lint:classes --fix",
    "lint:source": "oxlint --config ../../oxlint.config.ts --deny-warnings src",
    "preview": "astro preview",
    "test": "playwright test",
    "types": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "catalog:",
    "@iconify-icons/lucide": "catalog:",
    "@sindresorhus/slugify": "catalog:"
  },
  "devDependencies": {
    "@2digits/tsconfig": "catalog:",
    "@astrojs/check": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "astro": "catalog:",
    "astro-eslint-parser": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "jiti": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:astro-tooling",
    "vite": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
