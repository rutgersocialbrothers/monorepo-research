---
import AboutIntro from "../sections/about-intro/about-intro.astro";
import SiteFooter from "../sections/site-footer/site-footer.astro";
import ValueCards from "../sections/value-cards/value-cards.astro";
import MarketingBanner from "../sections/marketing-banner/marketing-banner.astro";
import PartnerCarousel from "../sections/partner-carousel/partner-carousel.astro";
import SiteHeader from "../sections/site-header/site-header.astro";
import HomeHero from "../sections/home-hero/home-hero.astro";
import CategoryRow from "../sections/category-row/category-row.astro";
import BannerPair from "../sections/banner-pair/banner-pair.astro";
import ProductRail from "../sections/product-rail/product-rail.astro";
import ImageText from "../sections/image-text/image-text.astro";
import ReviewRail from "../sections/review-rail/review-rail.astro";
import PublicationFeed from "../sections/publication-feed/publication-feed.astro";
import Faq from "../sections/faq/faq.astro";
import Link from "../components/link/link.astro";
import {referenceAssets as media} from "../sections/reference-assets";
import {prototypeCategories, prototypeBanners, prototypeProducts, prototypeReviews, prototypePublications, prototypeFaq} from "../sections/homepage.example-data";
import ImageSlider from "../sections/image-slider/image-slider.astro";
import BranchNav from "../sections/branch-nav/branch-nav.astro";
import SizeFinder from "../sections/size-finder/size-finder.astro";
import {prototypeBranches, prototypeSlides, prototypePromo, prototypeSale} from "../sections/prototype-update.example-data";
import Header from "./SectionHeader.astro";
import Block from "./Block.astro";
---

<Header title="Sections" eyebrow="Compositions">
  Page-level compositions built from the canonical design-system components. Sections own responsive layout and content structure while consuming the shared Tupak tokens and color modes.
</Header>

<div class="mb-10 rounded-(--ds-radius-lg) border border-border bg-surface-band p-6">
  <h3 class="text-xl">Current Tupak homepage candidate</h3>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">A real Astro composition of the current external homepage: navy header and footer, split-color hero, contained category row, natural/kraft banner pair, product cards, image/text, reviews, publications and FAQ. All business and review examples are explicitly prototypes. Design and asset rights are not production-approved.</p>
  <Link href="/preview" appearance="button" variant="nav" class="mt-5">Open composed preview →</Link>
</div>
<Block title="Updated prototype routes" description="Complete 6f9c7e2 reference update. Trials remain visible; production choices and merchant controls are decided during Liquid adaptation.">
  <nav class="flex flex-wrap gap-4 text-sm" aria-label="Updated reference examples">
    <a href="/overview" class="underline underline-offset-2">Section overview</a>
    <a href="/branches" class="underline underline-offset-2">Branches</a>
    <a href="/collection" class="underline underline-offset-2">Navy collection and gradient trial</a>
    <a href="/collection-v2" class="underline underline-offset-2">Light collection proposal</a>
    <a href="/product" class="underline underline-offset-2">Product reference</a>
    <a href="/section-image-slider" class="underline underline-offset-2">Image-slider variants</a>
  </nav>
</Block>
<Block title="Image slider" description="Three source routes, optional media and actions, arrows/dots, snap scrolling and inactive-slide inert state. No autoplay; source starting-slide option preserved.">
  <ImageSlider slides={prototypeSlides} startIndex={1} label="Prototype image slider" />
</Block>
<Block title="Branches" description="Six branch routes with candidate stand-in imagery. Not approved production photography or an active shop.">
  <BranchNav items={prototypeBranches} />
</Block>
<Block title="Size finder" description="Prototype dimension handoff to the local collection example; class-based filtering is a reference simulation, not proof of Shopify data configuration.">
  <SizeFinder action="/collection" />
</Block>

<Block title="Navy site header" description="Native disclosure navigation. Search is rendered only when a real search destination is supplied; this example has no fake account, cart or search outcome.">
  <SiteHeader title="Tupak Packaging" logo={{src: media.logo.src, alt: "Tupak Packaging"}} homeHref="/preview" catalogue={prototypeCategories.map(item => ({label: item.title, href: "/preview#categorieen"}))} links={[{label: "Maatwerkvoorbeeld", href: "/preview#maatwerk"}, {label: "Prototypevragen", href: "/preview#vragen"}]} branches={prototypeBranches} branchIndexHref="/branches" sale={prototypeSale} saleMotion={true} action={{label: "Preview", href: "/preview"}} />
</Block>

<Block title="Homepage hero" description="The source's pale fading band, two-color heading, product assortment photograph and optional navigation. Explicit candidate content, not a service claim.">
  <HomeHero heading="h2" title="Verpakkingen voor bedrijven." accent="Direct besteld of op maat gemaakt." eyebrow="Prototypevoorbeeld" text="De huidige Tupak-referentie als kandidaatontwerp; geen actueel aanbod." image={{src: media.hero.src, alt: "Kartonnen dozen, kokers en verpakkingsmaterialen"}} actions={[{label: "Bekijk de compositie", href: "/preview"}, {label: "Bekijk maatwerkvoorbeeld", href: "/preview#maatwerk"}]} />
</Block>

<Block title="Contained category row" description="The current source variant without a navy panel. Optional media, real links only, horizontal keyboard scrolling and disabled-at-boundary controls.">
  <CategoryRow title="Onze categorieën" items={prototypeCategories.map(item => ({...item, href: item.href ? `/preview${item.href}` : undefined}))} />
</Block>

<Block title="Banner pair" description="The pale natural green and warm kraft trial, with optional media and separate navigational calls to action. No whole-banner nested links.">
  <BannerPair title="Prototype bannerpaar" items={prototypeBanners.map(item => ({...item, action: item.action ? {...item.action, href: `/preview${item.action.href}`} : undefined}))} />
</Block>

<Block title="Product rail" description="Canonical ProductCard primitives. These static prototype products intentionally omit invented prices, tax treatment, stock, purchasing and product destinations.">
  <ProductRail title="Productvoorbeelden" eyebrow="Prototype · geen actueel aanbod" items={prototypeProducts} framed={true} promo={prototypePromo} />
</Block>

<Block title="Image and text" description="A real selected source image with a non-animated badge, optional points and a real preview destination. The composition also works without media.">
  <ImageText title="Een verpakking die alleen van jou is" eyebrow="Maatwerk · prototypevoorbeeld" text="Een kandidaatpresentatie met ruimte voor tekst, fotografie en een eigen ontwerp." image={{src: media.custom.src, alt: "Geopende postdoos met blauwe en rode bedrukking"}} badge="Eigen formaat · eigen ontwerp" points={[{title: "Voorbeeld van een formaat", icon: "pencil"}, {title: "Voorbeeld van een bedrukking", icon: "sparkles"}]} action={{label: "Bekijk de compositie", href: "/preview#maatwerk"}} />
</Block>

<Block title="Review rail" description="Presentation only, no Judge.me dependency or fabricated customer endorsements. Every specimen is explicitly labeled fictitious.">
  <ReviewRail title="Fictieve reviewvoorbeelden" note="Namen, sterren en teksten zijn uitsluitend prototypevoorbeelden, geen echte klantervaringen." items={prototypeReviews} />
</Block>

<Block title="Publication feed" description="Optional image, date, context and link. Actual source article links are preserved without inventing publication dates or editorial categories.">
  <PublicationFeed title="De laatste publicaties" eyebrow="Prototypepresentatie · bronartikelen" items={prototypePublications} />
</Block>

<Block title="FAQ" description="Native details/summary keyboard behavior with a split introduction and disclosure list. Preview answers do not invent delivery, payment or return policies; no SEO claim markup is emitted.">
  <Faq title="Snel antwoord op je vraag" eyebrow="Over dit prototype" items={prototypeFaq} />
</Block>

<Block title="Empty, optional media and long content" description="Caller-controlled empty messages and no-image layouts; text stays in normal document flow rather than being truncated.">
  <details class="rounded-(--ds-radius-lg) border border-border p-5">
    <summary class="cursor-pointer font-semibold">Open section edge-state examples</summary>
    <CategoryRow title="Lege categorieën" items={[]} />
    <ProductRail title="Lege producten" items={[]} />
    <ReviewRail title="Lege reviews" items={[]} />
    <PublicationFeed title="Lege publicaties" items={[]} />
    <BannerPair title="Lege banners" items={[]} />
    <ImageText title="Een lange titel voor een compositie zonder afbeelding, zodat ook tekstgedreven inhoud volledig beschikbaar blijft" text="Deze sectie heeft bewust geen beeld of actie. De inhoud bepaalt de hoogte en blijft zichtbaar op een smal scherm." />
    <Faq title="Lange vragen" items={[{question: "Hoe blijft een aanzienlijk langere vraag zonder afkapping beschikbaar op kleine en grote schermen?", answer: "De vraag en het antwoord blijven in de normale documentstroom staan. Er is geen vaste kaarthoogte of line-clamp die de inhoud verbergt."}]} />
    <Faq title="Lege vragen" items={[]} />
  </details>
</Block>

<Block title="About intro" description="A text-first introduction with an eyebrow, split-color heading, supporting copy and quote. Supplied editorial media is optional.">
  <div class="overflow-hidden rounded-(--ds-radius-lg) border border-border bg-background">
    <AboutIntro heading="h2" />
  </div>
</Block>

<Block title="Value cards" description="A simple three-column sample composition with a semantic surface, icon and short supporting copy.">
  <div class="overflow-hidden rounded-(--ds-radius-lg) border border-border bg-background">
    <ValueCards />
  </div>
</Block>

<Block title="Marketing banner" description="A centered banner with supporting copy and working navigation to component and contract examples.">
  <div class="overflow-hidden rounded-(--ds-radius-lg) border border-border bg-background">
    <MarketingBanner />
  </div>
</Block>

<Block title="Partner carousel" description="A horizontally scrollable generic sample collection with optional media, non-link cards when no destination is supplied, and accessible pagination.">
  <div class="overflow-hidden rounded-(--ds-radius-lg) border border-border bg-background">
    <PartnerCarousel />
  </div>
</Block>

<Block title="Navy site footer" description="The source footer-v3 composition with four columns and optional service row. Callers supply links and facts; no business address, contact, legal identifiers, payment marks or policy claims are invented.">
  <div class="overflow-hidden rounded-(--ds-radius-lg) border border-border bg-background">
    <SiteFooter />
  </div>
</Block>

<Block title="Section rules" description="Sections are page-level compositions, not primitive controls. Keep data and business logic outside the design-system renderer.">
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-(--ds-radius-lg) border border-border bg-card p-5">
      <h3 class="text-lg">Compose</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Reuse Buttons, Links, Cards, Icons and other canonical components instead of recreating their markup.</p>
    </div>
    <div class="rounded-(--ds-radius-lg) border border-border bg-card p-5">
      <h3 class="text-lg">Own layout</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Keep responsive grids, section spacing and media treatment inside the section.</p>
    </div>
    <div class="rounded-(--ds-radius-lg) border border-border bg-card p-5">
      <h3 class="text-lg">Stay token-driven</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Use semantic Tailwind utilities and authored CSS variables; do not add local style blocks or raw brand values.</p>
    </div>
  </div>
</Block>
