---
import Header from "./SectionHeader.astro"; import Block from "./Block.astro"; import Token from "./Token.astro"; import {group} from "./data";
const sizes=group("text").filter(t=>t.name.endsWith("-size"));
---
<Header title="Typography">Four families, a ten-step size scale with paired line heights, and four weights. Body text is text-sm (15px). Headings use the heading tokens, so a brand can swap its faces without touching components.</Header>
<Block title="Families"><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{group("font").map(t=><article class="sg-panel flex flex-col"><p class="text-6xl leading-none" style={`font-family:var(${t.name})`}>Aa</p><p class="mt-6 text-sm font-semibold capitalize">{t.name.replace("--ds-font-","")}</p><p class="mb-3 text-xs text-muted-foreground">{t.description}</p><Token name={t.name} value /></article>)}</div></Block>
<Block title="Type scale" description="Each size carries its line height: text-lg sets both."><div class="divide-y divide-border">{sizes.map(t=><div class="grid items-baseline gap-2 py-4 md:sg-type-columns"><Token name={t.name} label={t.name.replace("--ds-","").replace("-size","")} /><span class="sg-value" data-css-value={t.name}></span><p class="truncate" style={`font-size:var(${t.name});line-height:var(${t.name.replace("-size","-line-height")})`}>Design is how it works</p></div>)}</div></Block>
<Block title="Weights"><div class="grid grid-cols-2 gap-4 md:grid-cols-4">{group("font-weight").map(t=><article class="sg-panel"><p class="text-4xl" style={`font-weight:var(${t.name})`}>Ag</p><p class="mt-4 text-sm capitalize">{t.name.replace("--ds-font-weight-","")}</p><Token name={t.name} value /></article>)}</div></Block>
<Block title="Hierarchy in use" description="Page and card titles use the display family; section and dialog titles use the heading family. All headings use foreground-heading.">
 <article class="sg-panel space-y-4"><p class="text-xs font-semibold uppercase tracking-widest text-(color:--link-foreground)">Eyebrow · text-xs</p><p class="ds-display text-5xl">Display heading</p><h3 class="text-3xl">Section heading</h3><h4 class="text-xl">Subsection heading</h4><p class="max-w-prose text-base">Lead paragraph at text-base. Good typography sets a rhythm the reader never notices: consistent sizes, steady line heights, and enough contrast between levels to scan a page at a glance.</p><p class="max-w-prose text-sm text-muted-foreground">Body at text-sm in muted-foreground for supporting copy, captions and metadata.</p></article>
</Block>
<div class="grid gap-x-10 md:grid-cols-2">{["tracking","leading"].map(g=><Block title={g==="tracking"?"Letter spacing":"Line height"}><table class="sg-table"><thead><tr><th>Token</th><th>Value</th></tr></thead><tbody>{group(g).map(t=><tr><td><Token name={t.name} /></td><td><span class="sg-value" data-css-value={t.name}></span></td></tr>)}</tbody></table></Block>)}</div>
