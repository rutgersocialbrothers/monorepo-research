---
import Header from "./SectionHeader.astro"; import Block from "./Block.astro";
import Button from "../components/button/button.astro"; import Badge from "../components/badge/badge.astro"; import Card from "../components/card/card.astro"; import Alert from "../components/alert/alert.astro"; import Input from "../components/input/input.astro"; import Textarea from "../components/textarea/textarea.astro"; import Label from "../components/label/label.astro"; import Select from "../components/select/select.astro"; import Checkbox from "../components/checkbox/checkbox.astro"; import RadioGroup from "../components/radio-group/radio-group.astro"; import Switch from "../components/switch/switch.astro"; import Tabs from "../components/tabs/tabs.astro"; import Separator from "../components/separator/separator.astro"; import Dialog from "../components/dialog/dialog.astro"; import DropdownMenu from "../components/dropdown-menu/dropdown-menu.astro"; import Tooltip from "../components/tooltip/tooltip.astro"; import Icon from "../components/icon/icon.astro"; import Link from "../components/link/link.astro"; import EmptyState from "../components/empty-state/empty-state.astro"; import PageHeader from "../components/page-header/page-header.astro"; import FormSection from "../components/form-section/form-section.astro"; import {componentEntries} from "../registry";
const plans=[{value:"starter",label:"Starter"},{value:"team",label:"Team"},{value:"business",label:"Business"}];
---
<Header title="Components" eyebrow="Components">The Tupak component workbench, rendered as semantic HTML in Astro. Components use provisional semantic and component tokens, so light and dark modes restyle them without changing their markup.</Header>
<Block title="Button" description="Triggers an action. Tokens: --button-*. Use Link for navigation."><div class="sg-panel space-y-5"><div class="flex flex-wrap items-center gap-3"><Button>Primary</Button><Button variant="secondary">Secondary</Button><Button variant="outline">Outline</Button><Button variant="ghost">Ghost</Button><Link href="#theming">Explore modes</Link></div><div class="flex flex-wrap items-center gap-3"><Button size="sm"><Icon slot="leadingIcon" name="plus" size={16} />Small</Button><Button><Icon slot="leadingIcon" name="download" size={16} />Medium</Button><Button size="lg">Large<Icon slot="trailingIcon" name="arrow-right" size={16} /></Button><Button loading>Saving</Button><Button disabled>Disabled</Button></div></div></Block>
<Block title="Form controls" description="Text fields, select, checkbox, radio and switch share input tokens and the focus style.">
 <form id="controls-example" class="sg-panel grid gap-6 md:grid-cols-2">
 <div class="grid content-start gap-2"><Label for="cp-email">Email</Label><Input id="cp-email" name="email" type="email" describedBy="cp-email-help" placeholder="you@example.com" /><p id="cp-email-help" class="text-xs text-muted-foreground">We never share your email.</p></div>
 <div class="grid content-start gap-2"><Label for="cp-plan">Plan</Label><Select id="cp-plan" name="plan" placeholder="Choose a plan" options={plans} /></div>
 <div class="grid content-start gap-2"><Label for="cp-company">Company</Label><Input id="cp-company" invalid describedBy="cp-company-error" placeholder="Acme Inc." /><p id="cp-company-error" class="text-xs text-destructive">This field is required.</p></div>
 <div class="grid content-start gap-2"><Label for="cp-message">Message</Label><Textarea id="cp-message" name="message" placeholder="Tell us more…" /></div>
 <div class="grid content-start gap-3"><Checkbox label="Email me updates" name="updates" checked /><Checkbox label="Accept the terms" name="terms" /><Switch label="Notifications" name="notifications" checked /></div>
 <RadioGroup name="frequency" label="Frequency" value="weekly" options={[{value:"daily",label:"Daily"},{value:"weekly",label:"Weekly"},{value:"monthly",label:"Monthly"}]} />
 <p class="text-xs text-muted-foreground md:col-span-2">Interactive examples only; no information is sent.</p>
 </form>
</Block>
<Block title="Badge" description="Short status or category labels. Tokens: --badge-*."><div class="sg-panel flex flex-wrap gap-2"><Badge>Default</Badge><Badge variant="secondary">Secondary</Badge><Badge variant="outline">Outline</Badge><Badge variant="success">Active</Badge><Badge variant="warning">Pending</Badge><Badge variant="info">Beta</Badge><Badge variant="destructive">Failed</Badge></div></Block>
<Block title="Alert" description="Inline feedback. Tones use the subtle background with its paired text color."><div class="grid gap-3 md:grid-cols-2"><Alert variant="info" title="Heads up">A new version of the token set is available.</Alert><Alert variant="success" title="Saved">Your changes have been published.</Alert><Alert variant="warning" title="Check your input">Two fields need attention before you continue.</Alert><Alert variant="destructive" title="Payment failed">The card was declined. Try another method.</Alert></div></Block>
<Block title="Card" description="Groups related content. Tokens: --card-*."><div class="grid gap-6 md:grid-cols-3"><Card title="Example metric" description="Illustrative sample data"><Badge slot="action" variant="success">+12%</Badge><p class="text-3xl font-semibold">48,290</p></Card><Card class="md:col-span-2" title="Example invitation" description="A sample form composition; no invitation is sent."><div class="grid gap-2"><Label for="cp-invite">Email</Label><Input id="cp-invite" placeholder="name@company.com" /></div><Fragment slot="footer"><Button variant="ghost">Cancel</Button><Button>Send invite</Button></Fragment></Card></div></Block>
<Block title="Tabs and separator" description="Switch between views in one context; divide content."><div class="sg-panel grid gap-8 md:grid-cols-2"><Tabs label="Account views" items={[{label:"Account",content:"Manage your profile and preferences."},{label:"Billing",content:"Invoices, payment methods and plan."},{label:"Team",content:"Invite people and manage roles."}]} /><div><p class="text-sm font-medium">Tupak</p><p class="text-sm text-muted-foreground">Candidate Tupak design system</p><div class="my-4"><Separator /></div><div class="flex items-center gap-4 text-sm"><span>Tokens</span><Separator orientation="vertical" /><span>Components</span><Separator orientation="vertical" /><span>Modes</span></div></div></div></Block>
<Block title="Overlays" description="Dialog, menu and tooltip. Try them: focus stays in the dialog and Escape closes each. These examples do not save or change an account."><div class="sg-panel flex flex-wrap items-center gap-3"><Dialog id="profile-dialog"><div class="grid gap-2"><Label for="cp-dialog-name">Name</Label><Input id="cp-dialog-name" value="Ada Lovelace" /></div></Dialog><DropdownMenu items={[{label:"Profile",value:"profile"},{label:"Settings",value:"settings"},{label:"Log out",value:"logout",destructive:true}]} /><Tooltip /></div></Block>
<Block title="Patterns" description="Reusable compositions of canonical components: page header, form section and empty state."><div class="grid gap-6"><div class="sg-panel"><PageHeader title="Account settings" description="Manage your profile and preferences."><Button slot="actions">Save profile</Button></PageHeader></div><div class="sg-panel"><FormSection layout="split" title="Profile" description="Your public profile details."><label class="grid gap-2 text-sm">Full name<Input placeholder="Ada Lovelace" /></label><Button slot="actions">Save changes</Button></FormSection></div><EmptyState><Button slot="action">Create project</Button></EmptyState></div></Block>
<Block title="All variants and compositions" description="Automatically discovered from each component family. Expand a family to inspect its supported contract, states and examples.">
 <div class="space-y-3">{componentEntries.map(entry=><details class="rounded-lg border border-border p-5" id={`family-${entry.slug}`}><summary class="cursor-pointer text-sm font-semibold">{entry.name}<span class="ml-3 font-normal text-muted-foreground">{entry.groups.reduce((n,g)=>n+g.specimens.length,0)} specimens</span></summary><section aria-label={entry.name} class="mt-5"><p class="mb-4 text-sm text-muted-foreground">{entry.contract.description}</p>{entry.groups.map(group=><div class="mb-5"><h4 class="mb-3 text-sm capitalize">{group.title}</h4><div class="flex flex-wrap items-start gap-6 rounded-lg bg-muted/40 p-5">{group.specimens.map(specimen=><figure class:list={["min-w-0 max-w-full",specimen.label?"w-64":"",specimen.overlay&&"pb-56"]}>{specimen.label&&<label class="mb-2 block text-sm" for={specimen.id}>{specimen.label}</label>}<entry.Component {...specimen.props}>{entry.content}</entry.Component><figcaption class="sg-value mt-3">{specimen.caption}</figcaption></figure>)}</div></div>)}{entry.Examples&&<div class="sg-panel"><entry.Examples /></div>}<pre class="sg-code mt-4"><code>{entry.usage}</code></pre></section></details>)}</div>
</Block>
