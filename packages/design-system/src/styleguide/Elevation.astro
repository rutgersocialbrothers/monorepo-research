---
import Header from "./SectionHeader.astro"; import Block from "./Block.astro"; import Token from "./Token.astro"; import {group} from "./data";
const uses:Record<string,string>={xs:"Buttons, inputs",sm:"Cards at rest",md:"Raised cards, hover",lg:"Dropdowns, popovers",xl:"Modals, dialogs",inset:"Pressed and recessed"};
---
<Header title="Elevation">Candidate elevation adapts the prototype’s navy-tinted resting, overlay and modal shadows. Existing dark shadow colors remain independent; use lighter surface-raised backgrounds as well, since shadows fade on dark.</Header>
<Block title="Shadows"><div class="rounded-xl bg-surface-sunken p-6 md:p-10"><div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6">{group("shadow").map(t=><div><div class="flex aspect-4/3 items-end rounded-lg bg-surface-raised p-3" style={`box-shadow:var(${t.name})`}><span class="text-xs text-muted-foreground">{uses[t.name.replace("--ds-shadow-","")]}</span></div><div class="mt-3"><Token name={t.name} /></div></div>)}</div></div></Block>
<Block title="Layers" description="Named z-index values keep overlays in a predictable order. Native modal dialogs use the browser's top layer."><div class="grid items-center gap-10 lg:grid-cols-2"><div class="relative mx-auto h-64 w-full max-w-sm">{group("z").slice(1).map((t,i)=><div class="absolute flex h-24 w-2/3 justify-between rounded-lg border border-border bg-surface-raised p-3 shadow-md" style={`left:${i*6}%;top:${i*12}%`}><span class="text-xs capitalize">{t.name.replace("--ds-z-","")}</span><span class="sg-value" data-css-value={t.name}></span></div>)}</div><table class="sg-table"><thead><tr><th>Token</th><th>Value</th></tr></thead><tbody>{group("z").map(t=><tr><td><Token name={t.name} /></td><td><span class="sg-value" data-css-value={t.name}></span></td></tr>)}</tbody></table></div></Block>
