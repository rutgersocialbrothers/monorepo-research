---
import Header from "./SectionHeader.astro"; import Block from "./Block.astro"; import Token from "./Token.astro"; import Icon from "../components/icon/icon.astro"; import {iconContract} from "../components/icon/icon.contract";
const sizes=[12,16,20,24,32] as const;
---
<Header title="Iconography">Lucide icons, rendered as inline SVG. Size and stroke come from tokens; icons inherit text color, so they follow the Tupak light and dark modes automatically.</Header>
<Block title="Sizes" description="16px is the default inside buttons and inputs."><div class="sg-panel flex flex-wrap items-end gap-10">{sizes.map((size,i)=><div><Icon name="sparkles" size={size} /><div class="mt-3"><Token name={`--ds-icon-size-${["xs","sm","md","lg","xl"][i]}`} value /></div></div>)}</div></Block>
<Block title="Stroke" description="All icons share the same stroke token."><div class="flex items-center gap-4"><Token name="--ds-icon-stroke-width" value /><Icon name="heart" /><Icon name="star" /><Icon name="bell" /></div></Block>
<Block title="Common icons" description="Click to copy the Astro component. Decorative icons are hidden from assistive technology; set label when the icon carries meaning."><div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">{iconContract.props.name.values.map(name=><button type="button" data-copy-text={`<Icon name="${name}" />`} class="flex flex-col items-center gap-2 rounded-md border border-border bg-card px-2 py-4 transition-colors hover:bg-accent"><Icon name={name} size={20} /><span class="font-mono sg-caption text-muted-foreground">{name}</span></button>)}</div></Block>
