---
import Icon from "../../components/icon/icon.astro";
import Link from "../../components/link/link.astro";
import ScrollRail from "../scroll-rail/scroll-rail.astro";
import type {CategoryItem, SectionLink} from "../homepage.contract";
interface Props {title: string; items: ReadonlyArray<CategoryItem>; action?: SectionLink; emptyText?: string;}
const {title, items, action, emptyText = "Geen categorieën om te tonen."} = Astro.props;
---
<section class="py-10 md:py-14" aria-label={title}>
  <div class="container-page">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-4"><h2 class="text-3xl md:text-4xl">{title}</h2>{action && <Link href={action.href}>{action.label} →</Link>}</div>
    {items.length > 0 ? <ScrollRail label={title} size="category">{items.map(item => {
      const Tag = item.href ? "a" : "article";
      return <Tag href={item.href} class="group min-w-0 rounded-(--ds-radius-lg) outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
        <div class="grid aspect-square place-items-center overflow-hidden rounded-(--ds-radius-lg) bg-surface-sunken">{item.image ? <img src={item.image.src} alt={item.image.alt} width="816" height="816" loading="lazy" decoding="async" class="size-full object-contain [mix-blend-mode:var(--media-blend-mode)] transition-transform duration-300 motion-reduce:transition-none group-hover:scale-105" /> : <Icon name="image" size={32} />}</div>
        <div class="flex items-start justify-between gap-3 px-1 pt-4 text-sm font-semibold"><h3 class="min-w-0 break-words text-sm">{item.title}</h3>{item.href && <span class="mt-0.5 shrink-0 text-foreground-link"><Icon name="arrow-right" size={16} /></span>}</div>
      </Tag>;
    })}</ScrollRail> : <p class="rounded-(--ds-radius-lg) bg-surface-sunken p-6 text-muted-foreground">{emptyText}</p>}
  </div>
</section>
