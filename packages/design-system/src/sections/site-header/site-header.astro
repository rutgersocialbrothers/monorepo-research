---
import Icon from "../../components/icon/icon.astro";
import Link from "../../components/link/link.astro";
import type { SectionLink, SectionImage } from "../homepage.contract";
interface BranchLink extends SectionLink {
  /** Optional cut-out picture before the name; decorative beside the visible name, so usually an empty alt. */
  image?: SectionImage;
}
interface Props {
  title?: string;
  homeHref?: string;
  logo?: SectionImage;
  links?: ReadonlyArray<SectionLink>;
  catalogue?: ReadonlyArray<SectionLink>;
  /** Candidate Branches disclosure (source 6f9c7e2, not yet in stories/IA). Renders after the first `links` entry, the source order Assortiment · Maatwerk · Branches · … */
  branches?: ReadonlyArray<BranchLink>;
  /** Real overview destination: the bold panel foot and, on phones, a plain Branches link instead of the disclosure. */
  branchIndexHref?: string;
  branchesLabel?: string;
  branchIndexLabel?: string;
  /** Candidate accent-red sale link, last in the navigation row, with three decorative stars. */
  sale?: SectionLink;
  /** Trial: the stars keep twinkling (client request). Off by default; never under reduced motion; adds a native pause control. */
  saleMotion?: boolean;
  action?: SectionLink;
  searchAction?: string;
  searchLabel?: string;
}
const {title = "Tupak", homeHref = "/", logo, links = [], catalogue = [], branches = [], branchIndexHref, branchesLabel = "Branches", branchIndexLabel = "Alle branches", sale, saleMotion = false, action, searchAction, searchLabel = "Zoek in het assortiment"} = Astro.props;
const searchId = `site-search-${crypto.randomUUID()}`;
const [firstLink, ...otherLinks] = links;
const hasNavigation = links.length > 0 || catalogue.length > 0 || branches.length > 0 || sale !== undefined;
const linkClass = "rounded-sm outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring";
const summaryClass = "flex cursor-pointer list-none items-center gap-2 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring";
const panelLinkClass = "block rounded-sm px-3 py-2 outline-none hover:bg-surface-sunken focus-visible:ring-2 focus-visible:ring-ring";
const spark = "M5 0C5.6 3.4 6.6 4.4 10 5C6.6 5.6 5.6 6.6 5 10C4.4 6.6 3.4 5.6 0 5C3.4 4.4 4.4 3.4 5 0Z";
---
<header data-site-header>
  <div class="bg-surface-inverse text-foreground-inverse">
    <div class="container-page flex flex-wrap items-center gap-x-8 gap-y-4 py-6">
      <a href={homeHref} aria-label={`${title}, homepage`} class="shrink-0 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-current">
        {logo ? <img src={logo.src} alt={logo.alt} width="175" height="58" class="h-auto w-36 md:w-44" /> : <span class="text-3xl font-bold">{title}</span>}
      </a>
      {searchAction ? <form action={searchAction} method="get" role="search" class="flex min-w-0 flex-1 items-center rounded-full bg-background p-1 text-foreground">
        <label for={searchId} class="sr-only">{searchLabel}</label>
        <input id={searchId} name="q" type="search" placeholder={searchLabel} class="min-w-0 flex-1 rounded-full bg-transparent px-5 py-2 outline-none focus-visible:ring-2 focus-visible:ring-ring" />
        <button type="submit" aria-label="Zoeken" class="grid size-10 place-items-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-ring"><Icon name="search" size={20} /></button>
      </form> : <p class="hidden min-w-0 flex-1 rounded-full border border-current/20 px-5 py-3 text-sm text-foreground-inverse/75 sm:block">Ontwerpvoorbeeld · geen actieve webshop</p>}
      {action && <Link href={action.href} appearance="button" variant="outline" size="sm">{action.label}</Link>}
    </div>
  </div>
  {hasNavigation && <nav aria-label="Hoofdnavigatie" class="border-b border-border bg-background">
    <div class="container-page flex flex-wrap items-center gap-x-8 gap-y-3 py-4 text-sm font-semibold">
      {catalogue.length > 0 && <details data-header-disclosure class="group relative">
        <summary class={summaryClass}>Assortiment <span class="transition-transform group-open:rotate-180"><Icon name="chevron-down" size={16} /></span></summary>
        <ul class="absolute left-0 top-full z-20 mt-4 grid max-h-96 w-64 gap-1 overflow-y-auto rounded-(--ds-radius-lg) border border-border bg-background p-3 shadow-lg">{catalogue.map(link => <li><a href={link.href} class={panelLinkClass}>{link.label}</a></li>)}</ul>
      </details>}
      {firstLink && <a href={firstLink.href} class={linkClass}>{firstLink.label}</a>}
      {branches.length > 0 && <>
        <details data-header-disclosure class:list={["group relative", branchIndexHref && "max-sm:hidden"]}>
          <summary class={summaryClass}>{branchesLabel} <span class="transition-transform group-open:rotate-180"><Icon name="chevron-down" size={16} /></span></summary>
          <ul class="absolute left-0 top-full z-20 mt-4 grid w-max min-w-[28ch] gap-1 rounded-(--ds-radius-lg) border border-border bg-background p-3 shadow-lg">
            {branches.map(branch => <li><a href={branch.href} class="group/branch flex min-h-13 items-center gap-3 rounded-sm py-1 pr-3 pl-2 outline-none hover:bg-surface-sunken focus-visible:ring-2 focus-visible:ring-ring">
              {branch.image && <span class="grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-surface-sunken group-hover/branch:bg-surface-raised"><img src={branch.image.src} alt={branch.image.alt} width="40" height="40" loading="lazy" decoding="async" class="size-full object-contain p-1" /></span>}
              {branch.label}
            </a></li>)}
            {branchIndexHref && <li class="mt-2 border-t border-border pt-2"><a href={branchIndexHref} class:list={[panelLinkClass, "font-bold"]}>{branchIndexLabel}</a></li>}
          </ul>
        </details>
        {branchIndexHref && <a href={branchIndexHref} class:list={[linkClass, "sm:hidden"]}>{branchesLabel}</a>}
      </>}
      {otherLinks.map(link => <a href={link.href} class={linkClass}>{link.label}</a>)}
      {sale && <span data-sale class="inline-flex items-center gap-2">
        <a href={sale.href} class="relative inline-flex min-h-10 items-center rounded-sm px-2 text-primary outline-none hover:text-primary-hover focus-visible:ring-2 focus-visible:ring-ring">
          {sale.label}
          <svg data-sale-spark class="pointer-events-none absolute top-2 -left-0.5 size-[0.55em] fill-current max-sm:hidden" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d={spark} /></svg>
          <svg data-sale-spark class="pointer-events-none absolute top-1 -right-1.5 size-[0.45em] fill-current max-sm:hidden" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d={spark} /></svg>
          <svg data-sale-spark class="pointer-events-none absolute bottom-1.5 -right-0.5 size-[0.55em] fill-current max-sm:hidden" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d={spark} /></svg>
        </a>
        {saleMotion && <button type="button" data-sale-pause data-trial="sale-twinkle" hidden aria-pressed="false" aria-label="Sterrenanimatie pauzeren" class="grid size-6 shrink-0 cursor-pointer place-items-center rounded-full text-muted-foreground outline-none hover:bg-surface-sunken focus-visible:ring-2 focus-visible:ring-ring max-sm:hidden">
          <span data-sale-icon="pause" class="grid place-items-center"><svg viewBox="0 0 16 16" width="12" height="12" class="fill-current" aria-hidden="true" focusable="false"><path d="M4 3h3v10H4zM9 3h3v10H9z" /></svg></span>
          <span data-sale-icon="play" hidden class="grid place-items-center"><svg viewBox="0 0 16 16" width="12" height="12" class="fill-current" aria-hidden="true" focusable="false"><path d="M5 3l8 5-8 5z" /></svg></span>
        </button>}
      </span>}
    </div>
  </nav>}
</header>
<script>
  /* Header disclosures (source initDisclosures): Escape closes and returns focus to the summary; a click or focus outside closes. */
  for (const header of document.querySelectorAll<HTMLElement>("[data-site-header]")) {
    const disclosures = [...header.querySelectorAll<HTMLDetailsElement>("[data-header-disclosure]")];
    for (const disclosure of disclosures) {
      disclosure.addEventListener("keydown", event => {
        if (event.key !== "Escape" || !disclosure.open) {
          return;
        }
        disclosure.open = false;
        disclosure.querySelector("summary")?.focus();
      });
      disclosure.addEventListener("toggle", () => {
        if (disclosure.open) {
          for (const other of disclosures) {
            if (other !== disclosure) {
              other.open = false;
            }
          }
        }
      });
    }
    function closeOutside(event: Event) {
      for (const disclosure of disclosures) {
        if (disclosure.open && event.target instanceof Node && !disclosure.contains(event.target)) {
          disclosure.open = false;
        }
      }
    }
    document.addEventListener("click", closeOutside);
    document.addEventListener("focusin", closeOutside);
    const pause = header.querySelector<HTMLButtonElement>("[data-sale-pause]");
    if (pause) {
      initializeSaleMotion(header, pause);
    }
  }

  /* TRIAL sale twinkle (source .site-subnav__spark, 6f9c7e2): 1, 2, 3 appear, then go, in a 2.4s cycle of six
     0.4s steps, without a rest. OPEN source issue: WCAG 2.2.2 (level A) needs a pause for motion over five seconds;
     the source has none. This native pause control is added here; the trial itself is unresolved upstream.
     Under reduced motion the stars stand still and the control is hidden. */
  function initializeSaleMotion(header: HTMLElement, pause: HTMLButtonElement) {
    const sparks = [...header.querySelectorAll<SVGElement>("[data-sale-spark]")];
    const pauseIcon = pause.querySelector<HTMLElement>('[data-sale-icon="pause"]');
    const playIcon = pause.querySelector<HTMLElement>('[data-sale-icon="play"]');
    const reduced = globalThis.matchMedia("(prefers-reduced-motion: reduce)");
    const hidden = {transform: "scale(0)", opacity: 0, easing: "ease-in-out"};
    const shown = {transform: "scale(1)", opacity: 1, easing: "ease-in-out"};
    const keyframes: Array<Keyframe> = [
      {...hidden, offset: 0},
      {...shown, offset: 0.08},
      {...shown, offset: 0.5},
      {...hidden, offset: 0.58},
      {...hidden, offset: 1},
    ];
    let animations: Array<Animation> = [];
    let paused = false;
    function render() {
      pause.setAttribute("aria-pressed", String(paused));
      if (pauseIcon && playIcon) {
        pauseIcon.hidden = paused;
        playIcon.hidden = !paused;
      }
    }
    function sync() {
      for (const animation of animations) {
        animation.cancel();
      }
      animations = [];
      pause.hidden = reduced.matches;
      if (reduced.matches) {
        return;
      }
      animations = sparks.map((sparkElement, index) =>
        sparkElement.animate(keyframes, {duration: 2400, delay: index * 400, iterations: Number.POSITIVE_INFINITY, fill: "both"}),
      );
      if (paused) {
        for (const animation of animations) {
          animation.pause();
        }
      }
    }
    pause.addEventListener("click", () => {
      paused = !paused;
      for (const animation of animations) {
        if (paused) {
          animation.pause();
        } else {
          animation.play();
        }
      }
      render();
    });
    reduced.addEventListener("change", sync);
    render();
    sync();
  }
</script>
