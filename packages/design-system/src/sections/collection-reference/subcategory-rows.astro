---
import Icon from "../../components/icon/icon.astro";
import ScrollRail from "../scroll-rail/scroll-rail.astro";
import {catalogue, subcategoryRow} from "./collection.data";
interface Props {
  basePath: string;
  /** `panel`: the white subcategory cards of the navy head (collection); `circles`: round cut-outs of the light head (collection-v2). */
  appearance: "panel" | "circles";
}
const {basePath, appearance} = Astro.props;
const rows = [{key: "", type: undefined}, ...catalogue.map(type => ({key: type.name, type}))];
const circles = appearance === "circles";
---
<!--
  The subcategories of the current product type (snippets/subcategory-cards.html): filled up to six with related
  categories tagged "Gerelateerd"; with no resolved category, every product type. One row per product type is rendered
  and the page script shows the one ?categorie= resolves to and marks the current card; without script the
  product-type row stays.
-->
{rows.map(row => {
  const cards = subcategoryRow(row.type);
  return (
    <div data-subcategory-row={row.key} hidden={row.key !== ""}>
      <ScrollRail label="Subcategorieën" size="category">
        {cards.map(card => (
          <a
            href={`${basePath}?${new URLSearchParams({categorie: card.name})}`}
            data-subcategory={card.name}
            class:list={[
              "group flex min-w-0 flex-col text-foreground no-underline outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
              circles
                ? "items-center gap-3 rounded-(--ds-radius-md) aria-[current]:[&_[data-card-media]]:shadow-[inset_0_0_0_2px_var(--nav)] aria-[current]:[&_[data-card-name]]:font-bold"
                : "overflow-hidden rounded-(--ds-radius-lg) border border-border bg-surface-raised shadow-(--ds-shadow-xs) transition-[box-shadow,border-color] duration-(--ds-duration-fast) hover:border-border-strong hover:shadow-(--ds-shadow-md) active:translate-y-px motion-reduce:transition-none aria-[current]:border-nav aria-[current]:shadow-[0_0_0_1px_var(--nav)]",
            ]}
          >
            <span
              data-card-media
              class:list={[
                "relative grid place-items-center transition-colors duration-(--ds-duration-fast) motion-reduce:transition-none",
                circles
                  ? "aspect-square w-[min(100%,8.5rem)] overflow-hidden rounded-full bg-surface-raised group-hover:bg-surface-brand group-focus-visible:bg-surface-brand"
                  : "aspect-4/3 bg-surface-raised group-hover:bg-surface-warm-subtle group-focus-visible:bg-surface-warm-subtle",
              ]}
            >
              {card.image ? (
                <img src={card.image.src} alt="" loading="lazy" decoding="async" width="320" height="240" class:list={["absolute object-contain mix-blend-multiply", circles ? "inset-[14%] size-[72%]" : "inset-4 size-[calc(100%-2rem)]"]} />
              ) : (
                <span aria-hidden="true" class="text-muted-foreground"><Icon name="image" size={32} /></span>
              )}
              {card.related && <span class:list={["absolute rounded-(--ds-radius-sm) bg-surface-raised px-2 py-1 text-xs font-bold whitespace-nowrap text-muted-foreground shadow-(--ds-shadow-xs)", circles ? "bottom-0 left-1/2 -translate-x-1/2" : "top-2 left-2"]}>Gerelateerd</span>}
            </span>
            <span class:list={["flex items-center gap-2 text-sm", circles ? "justify-center text-center" : "min-h-[calc(2lh+1.5rem)] justify-between border-t border-border p-3"]}>
              <span data-card-name class:list={["line-clamp-2 min-w-0 hyphens-auto [overflow-wrap:anywhere] group-hover:underline group-hover:underline-offset-2", circles ? "font-normal text-balance" : "font-bold"]}>{card.name}</span>
              {!circles && <span class="shrink-0 text-foreground-heading"><Icon name="arrow-right" size={16} /></span>}
            </span>
          </a>
        ))}
      </ScrollRail>
    </div>
  );
})}
