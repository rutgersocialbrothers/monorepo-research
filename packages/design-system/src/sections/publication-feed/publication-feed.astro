---
import Icon from "../../components/icon/icon.astro";
import Link from "../../components/link/link.astro";
import ScrollRail from "../scroll-rail/scroll-rail.astro";
import type {PublicationItem, SectionLink} from "../homepage.contract";
interface Props {title: string; eyebrow?: string; items: ReadonlyArray<PublicationItem>; action?: SectionLink; emptyText?: string;}
const {title, eyebrow, items, action, emptyText = "Geen publicaties om te tonen."} = Astro.props;
---
<section class="bg-surface-sunken py-10 md:py-14" aria-label={title}>
  <div class="container-page">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-4"><div>{eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-foreground-link">{eyebrow}</p>}<h2 class="text-3xl md:text-4xl">{title}</h2></div>{action && <Link href={action.href}>{action.label} →</Link>}</div>
    {items.length > 0 ? <ScrollRail label={title}>{items.map(item => {
      const Tag = item.href ? "a" : "article";
      return <Tag href={item.href} class="group flex min-w-0 flex-col overflow-hidden rounded-(--ds-radius-lg) border border-border bg-card outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
        <div class="grid aspect-[4/3] place-items-center overflow-hidden bg-surface-band">{item.image ? <img src={item.image.src} alt={item.image.alt} width="640" height="480" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-300 motion-reduce:transition-none group-hover:scale-105" /> : <Icon name="image" size={32} />}</div>
        <div class="flex flex-1 flex-col p-5">{item.context && <p class="mb-3 text-xs font-semibold text-foreground-link">{item.context}</p>}<h3 class="break-words text-lg leading-snug">{item.title}</h3><div class="mt-auto flex items-end justify-between gap-3 pt-6 text-xs text-muted-foreground">{item.date && <time datetime={item.date.datetime}>{item.date.label}</time>}{item.href && <Icon name="arrow-right" size={20} />}</div></div>
      </Tag>;
    })}</ScrollRail> : <p class="text-muted-foreground">{emptyText}</p>}
  </div>
</section>
