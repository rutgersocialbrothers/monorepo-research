---
import Card from "../../components/card/card.astro";
import Link from "../../components/link/link.astro";
import ScrollRail from "../scroll-rail/scroll-rail.astro";
import type {ReviewItem, SectionLink} from "../homepage.contract";
interface Props {title: string; eyebrow?: string; note?: string; items: ReadonlyArray<ReviewItem>; action?: SectionLink; emptyText?: string;}
const {title, eyebrow, note, items, action, emptyText = "Nog geen reviews om te tonen."} = Astro.props;
---
<section class="bg-surface-sunken py-10 md:py-14" aria-label={title}>
  <div class="container-page">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-4"><div>{eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-foreground-link">{eyebrow}</p>}<h2 class="text-3xl md:text-4xl">{title}</h2>{note && <p class="mt-3 max-w-2xl text-sm text-muted-foreground">{note}</p>}</div>{action && <Link href={action.href}>{action.label} →</Link>}</div>
    {items.length > 0 ? <ScrollRail label={title}>{items.map(item => <Card title="" description="" class="h-full !gap-0 !rounded-(--ds-radius-lg) !shadow-none">
      {item.rating && <p class="mb-5 text-lg tracking-widest text-foreground-link"><span aria-hidden="true">{"★".repeat(item.rating)}<span class="text-border">{"☆".repeat(5 - item.rating)}</span></span><span class="sr-only">{item.rating} van 5 sterren</span></p>}
      <h3 class="text-lg">{item.title}</h3><blockquote class="mt-3 text-sm leading-relaxed text-muted-foreground"><p>{item.text}</p></blockquote>
      <div slot="footer" class="w-full border-t border-border pt-4 text-xs"><div class="flex flex-wrap justify-between gap-2">{item.author && <span class="font-semibold">{item.author}</span>}{item.date && <time datetime={item.date.datetime} class="text-muted-foreground">{item.date.label}</time>}</div>{item.subject && <Link href={item.subject.href} class="mt-3 inline-block">{item.subject.label}</Link>}</div>
    </Card>)}</ScrollRail> : <p class="text-muted-foreground">{emptyText}</p>}
  </div>
</section>
