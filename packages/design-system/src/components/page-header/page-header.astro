---
import type { PageHeaderProps } from "./page-header.contract";
interface Props extends PageHeaderProps { heading?: "h1" | "h2" | "h3"; }
const { title="Account settings", description="Manage your profile and preferences.", heading: Heading="h2" } = Astro.props;
---
<header class="flex flex-wrap items-start justify-between gap-6"><div><Heading class="ds-display text-3xl">{title}</Heading>{description && <p class="mt-2 text-muted-foreground">{description}</p>}</div><div class="flex flex-wrap gap-2"><slot name="actions" /></div></header>
