---
import type { PageHeaderProps } from "./page-header.contract";
interface Props extends PageHeaderProps { heading?: "h1" | "h2" | "h3"; }
const { title="Account settings", description="Manage your profile and preferences.", heading: Heading="h2" } = Astro.props;
---
<header class="flex flex-wrap items-end justify-between gap-6"><div><Heading class="font-heading text-3xl font-bold tracking-tight text-foreground-heading">{title}</Heading>{description && <p class="mt-3 max-w-2xl text-muted-foreground">{description}</p>}</div><div class="flex flex-wrap gap-3"><slot name="actions" /></div></header>
