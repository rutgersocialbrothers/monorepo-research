---
import type { RadioGroupProps } from "./radio-group.contract";
interface Props extends RadioGroupProps { name?: string; label: string; options: ReadonlyArray<{value:string;label:string;disabled?:boolean}>; }
const { label, options, name=`radio-${crypto.randomUUID()}`, value="comfortable", disabled=false } = Astro.props;
---
<fieldset disabled={disabled} class="grid gap-3 disabled:opacity-(--ds-opacity-disabled)">
 <legend class="mb-3 text-sm font-semibold text-foreground-heading">{label}</legend>
 {options.map(option=><label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm text-foreground has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-(--ds-opacity-disabled)"><input type="radio" name={name} value={option.value} checked={value===option.value} disabled={option.disabled} class="size-5 shrink-0 accent-nav focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" /><span>{option.label}</span></label>)}
</fieldset>
