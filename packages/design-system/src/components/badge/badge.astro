---
import type { BadgeProps } from "./badge.contract";
interface Props extends BadgeProps { class?: string; }
const { variant = "primary", class: className } = Astro.props;
const tones = { primary: "bg-primary text-primary-foreground", secondary: "bg-secondary text-secondary-foreground", outline: "border-border text-foreground", success: "bg-success-subtle text-success-subtle-foreground", warning: "bg-warning-subtle text-warning-subtle-foreground", info: "bg-info-subtle text-info-subtle-foreground", destructive: "bg-destructive-subtle text-destructive-subtle-foreground", ghost: "text-foreground" };
---
<span
  data-variant={variant}
  class:list={[
    "inline-flex w-fit items-center gap-1 rounded-(--badge-radius) border border-transparent px-2 py-0.5 text-(length:--ds-text-xs-size) font-(--badge-font-weight)",
    tones[variant],
    className,
  ]}
>
  <slot />
</span>
