---
import Input from "./input.astro";
---

<div class="grid w-full max-w-sm gap-2">
  <label class="text-sm font-medium" for="ds-example-input-email">Email address</label>
  <Input
    id="ds-example-input-email"
    type="email"
    value="not-an-email"
    invalid
    describedBy="ds-example-input-email-error"
  />
  <p id="ds-example-input-email-error" class="text-sm text-destructive">Enter a valid email address.</p>
</div>
