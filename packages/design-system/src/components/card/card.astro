---
import type { CardProps } from "./card.contract";
interface Props extends CardProps { class?: string; heading?: "h2" | "h3" | "h4"; }
const { title, description, heading: Heading = "h3", class: className } = Astro.props;
---
<article
  class:list={[
    "grid min-w-0 gap-6 rounded-(--card-radius) border-(length:--card-border-width) border-border bg-card p-(--card-padding) text-card-foreground shadow-(--card-shadow)",
    className,
  ]}
>
 {title && <header><Heading class="font-heading text-2xl font-bold text-foreground-heading">{title}</Heading>{description && <p class="mt-2 text-sm text-muted-foreground">{description}</p>}<slot name="action" /></header>}
 <div><slot /></div>
 {Astro.slots.has("footer") && <footer class="flex flex-wrap items-center gap-2"><slot name="footer" /></footer>}
</article>
