---
import type { EmptyStateProps } from "./empty-state.contract";
type Props = EmptyStateProps;
const { variant="bordered", title="No projects yet", description="Create your first project to get started." } = Astro.props;
---
<section class:list={["rounded-(--card-radius) bg-surface p-8 text-center",variant==="bordered"&&"border border-dashed border-border-strong"]}><h3 class="font-heading text-xl font-bold text-foreground-heading">{title}</h3><p class="mx-auto mt-3 max-w-lg text-sm text-muted-foreground">{description}</p><div class="mt-6 flex justify-center gap-3"><slot name="action" /></div></section>
