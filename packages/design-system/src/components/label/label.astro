---
import type { LabelProps } from "./label.contract";
interface Props extends LabelProps { for: string; }
const { for: target, required=false } = Astro.props;
---
<label for={target} class="text-sm font-semibold text-foreground-heading"><slot />{required && <span class="font-normal text-muted-foreground"> (required)</span>}</label>
