---
import DesignSystemLayout from "../layouts/DesignSystemLayout.astro";
import Icon from "../components/icon/icon.astro";
import {prototypeOverview} from "../sections/prototype-update.example-data";
const linkClass = "rounded-sm font-medium text-foreground-link underline underline-offset-2 hover:no-underline";
const viewOptions = [{view: "grid", label: "Grid", icon: "columns-3"}, {view: "list", label: "Lijst", icon: "list"}] as const;
---
<DesignSystemLayout title="Tupak · sectie-overzicht" description="A visual index of the Tupak prototype sections with static source captures linking to the live native Astro references.">
  <a lang="nl" href="#overview-main" class="sr-only z-50 rounded-sm bg-background p-4 text-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4">Ga naar de inhoud</a>
  <div lang="nl" class="border-b border-border bg-surface-band px-6 py-3 text-center text-xs leading-relaxed text-foreground">
    <strong>Tupak ontwerpkandidaat</strong> · overzicht uit JPPACQ/tupak-design-system 6f9c7e2. Documentatie-chrome, geen winkelonderdeel. <a href="/preview" class="underline underline-offset-2">Preview</a> · <a href="/#sections" class="underline underline-offset-2">Workbench-secties</a>
  </div>
  <main id="overview-main" lang="nl" data-overview data-view="grid" class="group/overview grid gap-8 pb-16">
    <div class="container-page pt-10 md:pt-14">
      <div class="grid max-w-[68ch] gap-3">
        <p class="text-xs font-bold text-foreground-link">Prototype</p>
        <h1 class="text-4xl md:text-5xl">Sectie-overzicht</h1>
        <p class="text-muted-foreground">Een visuele index van de bouwstenen van de Tupak-webshop. Open een kaart om de sectie, varianten, besluiten en open vragen te bekijken.</p>
        <p class="text-sm text-muted-foreground">De miniaturen zijn statische opnames uit de bron (6f9c7e2), geen live weergave. De links openen de live Astro-referenties; de PNG-link toont de volledige bronopname.</p>
      </div>
      <div class="mt-3 flex flex-col items-start justify-between gap-4 pt-3 sm:flex-row sm:items-center">
        <span class="text-sm text-muted-foreground">{prototypeOverview.length} secties</span>
        <div data-overview-switches role="group" aria-label="Weergave" hidden class="inline-flex gap-1 rounded-(--ds-radius-md) border border-border bg-surface-sunken p-1">
          {viewOptions.map(option => <button type="button" data-overview-switch={option.view} aria-pressed={option.view === "grid" ? "true" : "false"} class="inline-flex min-h-9 cursor-pointer items-center gap-2 rounded-(--ds-radius-sm) px-3 text-sm text-muted-foreground hover:bg-surface-raised aria-pressed:bg-surface-inverse aria-pressed:text-foreground-inverse"><Icon name={option.icon} size={16} />{option.label}</button>)}
        </div>
      </div>
    </div>
    <div class="container-page">
      <ul class="grid grid-cols-1 gap-5 group-data-[view=list]/overview:gap-4 sm:group-data-[view=grid]/overview:grid-cols-2 min-[961px]:group-data-[view=grid]/overview:grid-cols-3">
        {prototypeOverview.map(entry => <li class="min-w-0"><article class="relative grid h-full grid-rows-[auto_1fr] overflow-hidden rounded-(--ds-radius-md) border border-border bg-surface-raised shadow-sm hover:border-border-strong sm:group-data-[view=list]/overview:grid-cols-[minmax(320px,42%)_1fr] sm:group-data-[view=list]/overview:grid-rows-1">
          <div class="relative aspect-video overflow-hidden border-b border-border bg-surface-sunken sm:group-data-[view=list]/overview:aspect-[3/2] sm:group-data-[view=list]/overview:border-r sm:group-data-[view=list]/overview:border-b-0">
            <img src={entry.thumbnail.src} alt={entry.thumbnail.alt} width="1200" height="800" loading="lazy" decoding="async" class="block size-full object-cover" />
            <span class="absolute top-3 left-3 rounded-full bg-surface-raised px-2 py-0.5 text-xs font-semibold shadow-sm">Statische bronopname</span>
            <span aria-hidden="true" class="absolute right-3 bottom-3 grid size-8 place-items-center rounded-full bg-surface-raised shadow-sm"><Icon name="arrow-right" size={16} /></span>
          </div>
          <div class="grid content-start gap-3 p-5 sm:group-data-[view=list]/overview:content-center sm:group-data-[view=list]/overview:p-6">
            <div class="grid gap-1">
              <h2 class="text-xl"><a href={entry.primary.href} data-overview-primary class="outline-none after:absolute after:inset-0 after:rounded-(--ds-radius-md) after:content-[''] focus-visible:after:outline-2 focus-visible:after:outline-offset-3 focus-visible:after:outline-ring">{entry.title}</a></h2>
              <p class="text-xs font-semibold text-foreground-link">Live Astro · {entry.primary.label}</p>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground">{entry.description}</p>
            <p class="border-t border-border pt-3 text-sm leading-relaxed text-muted-foreground"><b class="text-foreground">Doel:</b> {entry.purpose}</p>
            <ul class="relative z-10 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label={`Links voor ${entry.title}`}>
              {entry.related.map(link => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
              <li><a href={entry.capture} class={linkClass}>Bronopname (PNG)</a></li>
            </ul>
          </div>
        </article></li>)}
      </ul>
    </div>
  </main>
</DesignSystemLayout>
<script>
  // Grid or list, from ?view=grid|list, else the browser's last choice. Presentation chrome only.
  const overviewKey = "tupak-overview-view";
  const overview = document.querySelector<HTMLElement>("[data-overview]");
  const switches = overview?.querySelector<HTMLElement>("[data-overview-switches]");
  if (overview && switches) {
    initializeOverview(overview, switches);
  }

  function initializeOverview(root: HTMLElement, group: HTMLElement) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>("[data-overview-switch]")];
    function setView(view: string, persist: boolean) {
      root.dataset.view = view;
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.overviewSwitch === view));
      }
      if (persist) {
        try {
          localStorage.setItem(overviewKey, view);
        } catch {
          // Storage is optional.
        }
      }
    }
    const requested = new URLSearchParams(location.search).get("view");
    let initial = "grid";
    if (requested === "grid" || requested === "list") {
      initial = requested;
    } else {
      try {
        if (localStorage.getItem(overviewKey) === "list") {
          initial = "list";
        }
      } catch {
        // Storage is optional.
      }
    }
    for (const button of buttons) {
      button.addEventListener("click", () => setView(button.dataset.overviewSwitch === "list" ? "list" : "grid", true));
    }
    setView(initial, false);
    group.hidden = false;
  }
</script>
